<Window x:Class="Task1_XAML_Design.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task1_XAML_Design"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

		<DockPanel>
			<!--Так как StackPanel выравнивает дочерние элементы по горизонтали использовал Grid-->
			<Grid DockPanel.Dock="Top" Background="Brown" Height="50">
				<TextBlock Text="8 часов мучений и унижений :(" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
			</Grid>
			<!--Оставил StackPanel так как нужен переход на след строку-->
			<StackPanel DockPanel.Dock="Left" Background="Yellow" Width="100">
				<TextBlock Text="За что" TextAlignment="Center" Margin="0,10" FontSize="16"/>
				<TextBlock Text="За что" TextAlignment="Center" Margin="0,10" FontSize="16"/>
				<TextBlock Text="За что" TextAlignment="Center" Margin="0,10" FontSize="16"/>
				<TextBlock Text="За что" TextAlignment="Center" Margin="0,10" FontSize="16"/>

			</StackPanel>
			<StackPanel DockPanel.Dock="Right" Background="LawnGreen" Width="100">
				<TextBlock Text="АААА" TextAlignment="Center" Margin="0,10" FontSize="16"/>
				<TextBlock Text="АААА" TextAlignment="Center" Margin="0,10" FontSize="16"/>
				<TextBlock Text="АААА" TextAlignment="Center" Margin="0,10" FontSize="16"/>
				<TextBlock Text="АААА" TextAlignment="Center" Margin="0,10" FontSize="16"/>
			</StackPanel>
			<Grid DockPanel.Dock="Bottom">
				<Grid.RowDefinitions>
					<RowDefinition/>
					<RowDefinition/>
				</Grid.RowDefinitions>
				<Grid Grid.Row="0"
							Background="Coral">
					<TextBlock Text="Важен порядок в DockPanel.Dock"  VerticalAlignment="Center" HorizontalAlignment="Center" />
				</Grid>
				<Grid Grid.Row="1"
							Background="Olive">
					<TextBlock Text="StackPanel выравнивается только горизантально памятка в коде" VerticalAlignment="Center" HorizontalAlignment="Center"/>
				</Grid>
			</Grid>

		</DockPanel>
	</Grid>
</Window>
<!--StackPanel выравнивает дочерние элементы только горизантально,
то есть при попытке указать что хочешь выравнить вертикально по центру программа выдаст тебе,
что много хочешь иди гуляй.
Ориентацию много раз попробовал надеясь что программа очнется и наконец оцентрует как надо, не помогло. :( Попробовал Grid помогло...

Важен порядок в DockPanel.Dock иначе будещь думать почему при указание первым Top другие не отображаются, 
крч мутная тема лучше пробовать еще, но вроде разобрался как с ним дружить:( !!!

Row и Column Span не пригодились, чтоб не забыл, они помогают объединять колонки и строки

Тут я использовал margin так как растояние между строками не придумал как автоматизировать:
<TextBlock Text="За что" TextAlignment="Center" Margin="0,10" FontSize="16"/>

Пока проводились эксперементы придумал как убрать сетку,
то есть DockPanel помог

Остальные пытки внизу, к сожелению это только часть провалов 
Если что оно запускается, сам удивлен 0_0

2 месяца без компа дали о себе знать -_-

На этом мои полномочия закончены zzz...
-->












