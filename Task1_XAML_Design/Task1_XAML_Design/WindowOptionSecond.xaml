<Window x:Class="Task1_XAML_Design.WindowOptionSecond"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task1_XAML_Design"
        mc:Ignorable="d"
        Title="WindowOptionSecond" Height="450" Width="800">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="50"/>
			<RowDefinition/>
			<RowDefinition/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="150"/>
			<ColumnDefinition/>
			<ColumnDefinition Width="150"/>
		</Grid.ColumnDefinitions>
		<Grid Grid.ColumnSpan="3" Background="LightGray">
			<StackPanel  VerticalAlignment="Center" HorizontalAlignment="Center" >
				<TextBlock Text="My first XAML DESIGN" FontSize="16"/>
			</StackPanel>
		</Grid>
		<StackPanel Grid.Row="1" Grid.RowSpan="2" Background="Gray">
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
				<TextBlock Text="Some Text" FontSize="14" Margin="0,10" Foreground="White" />
				<TextBlock Text="Some Text" FontSize="14" Margin="0,10" Foreground="White"/>
				<TextBlock Text="Some Text" FontSize="14" Margin="0,10" Foreground="White"/>
				<TextBlock Text="Some Text" FontSize="14" Margin="0,10" Foreground="White"/>
			</StackPanel>
		</StackPanel>

		<StackPanel Grid.Column="2" Grid.Row="1" Grid.RowSpan="2" Background="Gray">
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
				<TextBlock Text="Some Text1" FontSize="14" Margin="0,10" Foreground="White"/>
				<TextBlock Text="Some Text1" FontSize="14" Margin="0,10" Foreground="White"/>
				<TextBlock Text="Some Text1" FontSize="14" Margin="0,10" Foreground="White"/>
				<TextBlock Text="Some Text1" FontSize="14" Margin="0,10" Foreground="White"/>
			</StackPanel>
		</StackPanel>

		<Grid Grid.Column="1" Grid.Row="1" Background="LightCoral">
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
				<TextBlock Text="Top Rectangle" Foreground="White" FontSize="14"/>
			</StackPanel>
		</Grid>

		<Grid Grid.Column="1" Grid.Row="2" Background="Fuchsia">
			<StackPanel  HorizontalAlignment="Center" VerticalAlignment="Center" >
				<TextBlock Text="Bottom Rectangle" Foreground="White" FontSize="14"/>
			</StackPanel>
		</Grid>
	</Grid>
</Window>
